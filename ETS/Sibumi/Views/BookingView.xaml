<UserControl x:Class="Sibumi.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                    <TextBlock Text="Booking Baru"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Booking Pendakian" Style="{StaticResource H1}"/>
                <TextBlock Text="Kelola pendaftaran, konfirmasi, dan status pendakian." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="40,9,12,9"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}"
                           Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Text="Cari kode, nama ketua, atau NIK" Foreground="{DynamicResource MutedBrush}"
                           Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Search}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ComboBox Grid.Column="1" Margin="12,0,0,0" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Ubah" Command="{Binding EditCommand}" Margin="0,0,8,0"/>
            <Button Content="Konfirmasi" Command="{Binding StatusCommand}" CommandParameter="Dikonfirmasi" Margin="0,0,8,0"/>
            <Button Content="Mulai Mendaki" Command="{Binding StatusCommand}" CommandParameter="Mendaki" Margin="0,0,8,0"/>
            <Button Content="Selesai" Command="{Binding StatusCommand}" CommandParameter="Selesai" Margin="0,0,8,0"/>
            <Button Content="Batalkan" Style="{StaticResource Danger}" Command="{Binding StatusCommand}" CommandParameter="Dibatalkan" Margin="0,0,8,0"/>
            <Button Content="Hapus" Style="{StaticResource Danger}" Command="{Binding DeleteCommand}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KODE" Binding="{Binding KodeBooking}" Width="150"/>
                        <DataGridTextColumn Header="KETUA ROMBONGAN" Binding="{Binding NamaKetua}" Width="*"/>
                        <DataGridTextColumn Header="JALUR" Binding="{Binding NamaJalur}" Width="1.3*"/>
                        <DataGridTextColumn Header="NAIK" Binding="{Binding TanggalNaik, StringFormat='dd MMM yyyy', ConverterCulture=id-ID}" Width="110"/>
                        <DataGridTextColumn Header="ORANG" Binding="{Binding JumlahAnggota}" Width="70"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalBiaya, StringFormat='Rp {0:N0}', ConverterCulture=id-ID}" Width="120"/>
                        <DataGridTemplateColumn Header="STATUS" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,1,8,0" Fill="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Tidak ada booking ditemukan" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Coba ubah kata kunci atau filter status." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Text="Memuat data..." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding PrevCommand}" Margin="0,0,8,0" ToolTip="Halaman sebelumnya">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Command="{Binding NextCommand}" ToolTip="Halaman berikutnya">
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>