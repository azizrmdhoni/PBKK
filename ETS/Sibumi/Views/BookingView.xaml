<UserControl x:Class="Sibumi.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource Page}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,22">
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Command="{Binding AddCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Booking Baru"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Booking" Style="{StaticResource H1}"/>
                <TextBlock Text="Cari, konfirmasi, dan pantau status pendaki." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Top">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="40,0,12,0"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}"
                           Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Text="Cari kode, nama, atau NIK" Foreground="{DynamicResource MutedBrush}"
                           Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Search}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ListBox Grid.Column="1" Style="{StaticResource ChipList}" Margin="16,0,0,0" VerticalAlignment="Top"
                     ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" Margin="0,0,16,0">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KODE" Binding="{Binding KodeBooking}" Width="140"/>
                        <DataGridTemplateColumn Header="KETUA ROMBONGAN" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NamaKetua}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding NamaJalur}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="NAIK" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TanggalNaik, StringFormat='dd MMM yyyy', ConverterCulture=id-ID}"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                            <Run Text="{Binding JumlahAnggota, Mode=OneWay}"/><Run Text=" orang"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="STATUS" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Left">
                                        <Border CornerRadius="12" Opacity="0.15" Background="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Padding="12,4"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Tidak ada booking ditemukan" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Coba ubah kata kunci atau filter status." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Text="Memuat data..." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Pilih satu booking" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Detail dan aksi akan muncul di sini." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="22">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Selected.KodeBooking}" Style="{StaticResource Muted}" FontFamily="Consolas" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <Border CornerRadius="12" Opacity="0.15" Background="{Binding Selected.Status, Converter={StaticResource StatusBrush}}"/>
                                <TextBlock Text="{Binding Selected.Status}" FontSize="12" FontWeight="SemiBold" Padding="12,4"
                                           Foreground="{Binding Selected.Status, Converter={StaticResource StatusBrush}}"/>
                            </Grid>
                        </Grid>
                        <TextBlock Text="{Binding Selected.NamaKetua}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding Selected.NamaJalur}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Naik" Style="{StaticResource Muted}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding Selected.TanggalNaik, StringFormat='dd MMM yyyy', ConverterCulture=id-ID}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Turun" Style="{StaticResource Muted}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding Selected.TanggalTurun, StringFormat='dd MMM yyyy', ConverterCulture=id-ID}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Anggota" Style="{StaticResource Muted}"/>
                            <TextBlock HorizontalAlignment="Right"><Run Text="{Binding Selected.JumlahAnggota, Mode=OneWay}"/><Run Text=" orang"/></TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Total biaya" Style="{StaticResource Muted}"/>
                            <TextBlock HorizontalAlignment="Right" FontWeight="Bold"
                                       Text="{Binding Selected.TotalBiaya, StringFormat='Rp {0:N0}', ConverterCulture=id-ID}"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="No. HP" Style="{StaticResource Muted}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding Selected.NoHp}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="NIK" Style="{StaticResource Muted}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding Selected.NIK}"/>
                        </Grid>
                        <Grid Margin="0,0,0,18">
                            <TextBlock Text="Email" Style="{StaticResource Muted}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding Selected.Email}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,0,-8,0">
                            <Button Content="Ubah" Command="{Binding EditCommand}" Margin="0,0,8,8"/>
                            <Button Content="Konfirmasi" Style="{StaticResource Primary}" Command="{Binding StatusCommand}" CommandParameter="Dikonfirmasi" Margin="0,0,8,8"/>
                            <Button Content="Mulai Mendaki" Command="{Binding StatusCommand}" CommandParameter="Mendaki" Margin="0,0,8,8"/>
                            <Button Content="Selesai" Command="{Binding StatusCommand}" CommandParameter="Selesai" Margin="0,0,8,8"/>
                            <Button Content="Batalkan" Style="{StaticResource Danger}" Command="{Binding StatusCommand}" CommandParameter="Dibatalkan" Margin="0,0,8,8"/>
                            <Button Content="Hapus" Style="{StaticResource Danger}" Command="{Binding DeleteCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,16,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding PrevCommand}" Margin="0,0,8,0" Padding="0" MinWidth="42" ToolTip="Halaman sebelumnya">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Command="{Binding NextCommand}" Padding="0" MinWidth="42" ToolTip="Halaman berikutnya">
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
