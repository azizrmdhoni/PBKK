<Window x:Class="Sibumi.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIBUMI" Width="940" Height="580" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1D7F5B" Offset="0"/>
                    <GradientStop Color="#0B3328" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ClipToBounds="True">
                <Path Fill="White" Opacity="0.08" Stretch="Fill" VerticalAlignment="Bottom" Height="230"
                      Data="M0,230 L0,110 L70,60 L120,100 L210,10 L300,120 L350,80 L470,230 Z"/>
                <Path Fill="White" Opacity="0.12" Stretch="Fill" VerticalAlignment="Bottom" Height="150"
                      Data="M0,150 L0,90 L80,40 L150,100 L240,0 L330,90 L400,50 L500,150 Z"/>

                <StackPanel Margin="48,44,48,0" VerticalAlignment="Top" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="12" Background="White">
                        <Viewbox Width="22" Height="22">
                            <Path Fill="#1D7F5B" Data="M2,19 L9.5,6 L13.5,13 L16,9.5 L22,19 Z"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="SIBUMI" FontSize="20" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Margin="48,0,48,60">
                    <TextBlock Text="Kelola pendakian&#x0A;dengan lebih rapi." FontSize="34" FontWeight="Bold"
                               Foreground="White" LineHeight="42"/>
                    <TextBlock Text="Booking, kuota harian, dan status pendaki dalam satu aplikasi."
                               FontSize="14" Foreground="#BFE3D3" TextWrapping="Wrap" Margin="0,14,0,0" MaxWidth="360"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="56,0">
            <TextBlock Text="Masuk" Style="{StaticResource H1}"/>
            <TextBlock Text="Silakan masuk untuk melanjutkan." Style="{StaticResource Muted}" Margin="0,6,0,28"/>

            <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,16">
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="36,0,12,0"/>
                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="12,0,0,0"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,22">
                <PasswordBox x:Name="PwdBox" PasswordChanged="PwdBox_PasswordChanged" Padding="36,0,12,0"/>
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="12,0,0,0"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <Grid Margin="0,0,0,16" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource DangerBrush}" Opacity="0.12" CornerRadius="10"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           FontWeight="SemiBold" Padding="14,10"/>
            </Grid>

            <Button Style="{StaticResource Primary}" MinHeight="44" IsDefault="True" Command="{Binding LoginCommand}">
                <TextBlock Text="Masuk" HorizontalAlignment="Center" FontWeight="SemiBold"/>
            </Button>
            <TextBlock Text="Memeriksa akun..." Style="{StaticResource Muted}" Margin="0,14,0,0" HorizontalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</Window>
