<Window x:Class="Sibumi.Views.BookingFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="560" Height="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Language="id-ID"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="22" Margin="0,0,0,20"/>

            <TextBlock Text="Jalur pendakian" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Jalurs}" SelectedItem="{Binding SelectedJalur}" DisplayMemberPath="Display"/>
            <TextBlock Text="{Binding JalurInfo}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,14"/>

            <TextBlock Text="Nama ketua rombongan" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding NamaKetua, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NIK" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding NIK, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="No. HP" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding NoHp, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Email (opsional)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Jumlah anggota" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding JumlahText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tanggal naik" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding TanggalNaik}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Tanggal turun" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding TanggalTurun}"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Estimasi}" FontWeight="Bold"/>
                    <TextBlock Text="Estimasi biaya" Style="{StaticResource Muted}"/>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,14" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Menyimpan..." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Batal" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="Simpan" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
