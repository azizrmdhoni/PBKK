<Window x:Class="Sibumi.Views.BookingFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="600" Height="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Language="id-ID"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="32,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Batal" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="Simpan Booking" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsGunungDitutup, Converter={StaticResource Not}}"/>
                </StackPanel>
                <TextBlock Text="Menyimpan..." Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="24"/>
                <TextBlock Text="Isi data ketua rombongan dan jadwal pendakian." Style="{StaticResource Muted}" Margin="0,4,0,24"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Destinasi Gunung dan Jadwal" Style="{StaticResource H2}" Margin="0,0,0,16"/>

                        <!-- Pemilihan Gunung -->
                        <TextBlock Text="Pilih Gunung" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Gunungs}" SelectedItem="{Binding SelectedGunung}" Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Alert Peringatan jika Gunung Ditutup / Tidak Bisa Didaki -->
                        <Border Margin="0,0,0,14" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="14,10"
                                Visibility="{Binding IsGunungDitutup, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#EF4444" FontSize="15" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="Gunung ini sedang ditutup" FontWeight="SemiBold" Foreground="#DC2626" FontSize="13"/>
                                    <TextBlock Text="{Binding GunungStatusWarning}" TextWrapping="Wrap" Foreground="#991B1B" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Pemilihan Jalur -->
                        <TextBlock Text="Jalur Pendakian" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Jalurs}" SelectedItem="{Binding SelectedJalur}"
                                  IsEnabled="{Binding IsGunungDitutup, Converter={StaticResource Not}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NamaJalur}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding JalurInfo}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Jumlah anggota" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding JumlahText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tanggal naik" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding TanggalNaik}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Tanggal turun" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding TanggalTurun}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Ketua rombongan" Style="{StaticResource H2}" Margin="0,0,0,16"/>

                        <TextBlock Text="Nama lengkap" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NamaKetua, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="NIK (16 digit)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NIK, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="No. HP" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NoHp, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Email (opsional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="14" Padding="20,16" Background="{DynamicResource SelectedBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Estimasi}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Estimasi biaya" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Grid Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource DangerBrush}" Opacity="0.12" CornerRadius="10"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Padding="14,10"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
