<Window x:Class="Sibumi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sibumi.ViewModels"
        xmlns:views="clr-namespace:Sibumi.Views"
        Title="SIBUMI" Width="1360" Height="800" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookingViewModel}">
            <views:BookingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JalurViewModel}">
            <views:JalurView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel Margin="18,26,18,18">
                <Border DockPanel.Dock="Bottom" CornerRadius="12" Padding="12" Background="{DynamicResource SidebarHoverBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource SidebarActiveBrush}">
                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource SidebarBarBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding UserRole}" FontSize="12" Foreground="{DynamicResource SidebarMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding LogoutCommand}" Style="{StaticResource Ghost}" Padding="10,8"
                                Foreground="{DynamicResource SidebarMutedBrush}" ToolTip="Keluar">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,34">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource SidebarBarBrush}">
                            <Viewbox Width="22" Height="22">
                                <Path Fill="{DynamicResource SidebarBrush}" Data="M2,19 L9.5,6 L13.5,13 L16,9.5 L22,19 Z"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SIBUMI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextBrush}"/>
                            <TextBlock Text="Booking Pendakian" FontSize="11" Foreground="{DynamicResource SidebarMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarMutedBrush}" Margin="14,0,0,8"/>

                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Dashboard"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                 IsChecked="{Binding Active, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Dashboard}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE787;" Content="Booking"
                                 Command="{Binding NavigateCommand}" CommandParameter="Booking"
                                 IsChecked="{Binding Active, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Booking}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE707;" Content="Jalur Pendakian"
                                 Command="{Binding NavigateCommand}" CommandParameter="Jalur"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding Active, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Jalur}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Pengaturan"
                                 Command="{Binding NavigateCommand}" CommandParameter="Pengaturan"
                                 IsChecked="{Binding Active, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Pengaturan}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl Content="{Binding Current}" Margin="36,30,36,26"/>

            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,30" Padding="16,14" CornerRadius="12"
                    MaxWidth="440" Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastKind}" Value="Success">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ToastKind}" Value="Error">
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Top" Margin="0,2,12,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE946;"/>
                                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ToastKind}" Value="Success">
                                        <Setter Property="Text" Value="&#xE73E;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ToastKind}" Value="Error">
                                        <Setter Property="Text" Value="&#xE711;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" FontWeight="SemiBold" MaxWidth="360"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
