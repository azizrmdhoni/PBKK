<Window x:Class="Sibumi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sibumi.ViewModels"
        xmlns:views="clr-namespace:Sibumi.Views"
        Title="SIBUMI" Width="1280" Height="760" MinWidth="1060" MinHeight="660"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookingViewModel}">
            <views:BookingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JalurViewModel}">
            <views:JalurView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24,16,16">
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Card}" Padding="12" CornerRadius="8" Background="{DynamicResource Surface2Brush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource OnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding UserRole}" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Command="{Binding LogoutCommand}" Style="{StaticResource Ghost}" Margin="0,8,0,0" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Keluar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <StackPanel Margin="10,0,0,28">
                        <TextBlock Text="SIBUMI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Booking &amp; Manajemen Pendakian" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>

                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Dashboard"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                 IsChecked="{Binding Active, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Dashboard}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE787;" Content="Booking"
                                 Command="{Binding NavigateCommand}" CommandParameter="Booking"
                                 IsChecked="{Binding Active, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Booking}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE707;" Content="Jalur Pendakian"
                                 Command="{Binding NavigateCommand}" CommandParameter="Jalur"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding Active, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Jalur}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Pengaturan"
                                 Command="{Binding NavigateCommand}" CommandParameter="Pengaturan"
                                 IsChecked="{Binding Active, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Pengaturan}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl Content="{Binding Current}" Margin="32,28,32,24"/>

            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Padding="18,12" CornerRadius="10"
                    MaxWidth="420" Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastKind}" Value="Success">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ToastKind}" Value="Error">
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>
                </Border.Effect>
                <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
</Window>