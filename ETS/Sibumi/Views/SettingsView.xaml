<UserControl x:Class="Sibumi.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="Pengaturan" Style="{StaticResource H1}" Margin="0,0,0,20"/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Tampilan" Style="{StaticResource H2}"/>
                <TextBlock Text="Pilihan tema disimpan di komputer ini." Style="{StaticResource Muted}" Margin="0,2,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="theme" Style="{StaticResource Segment}" Content="Gelap"  IsChecked="{Binding IsDark}"/>
                    <RadioButton GroupName="theme" Style="{StaticResource Segment}" Content="Terang" IsChecked="{Binding IsLight}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Profil" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                <TextBlock Text="Nama" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Nama}" Margin="0,0,0,12"/>
                <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Username}" Margin="0,0,0,12"/>
                <TextBlock Text="Peran" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Role}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>