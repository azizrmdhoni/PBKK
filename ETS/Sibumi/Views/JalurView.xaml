<UserControl x:Class="Sibumi.Views.JalurView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,20">
            <TextBlock Text="Jalur Pendakian" Style="{StaticResource H1}"/>
            <TextBlock Text="Atur kuota harian dan tarif tiap jalur. Hanya Administrator." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0,0,16,0">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="GUNUNG" Binding="{Binding NamaGunung}" Width="1.3*"/>
                    <DataGridTextColumn Header="JALUR" Binding="{Binding NamaJalur}" Width="*"/>
                    <DataGridTextColumn Header="KUOTA/HARI" Binding="{Binding KuotaHarian}" Width="100"/>
                    <DataGridTextColumn Header="TARIF" Binding="{Binding TarifPerOrang, StringFormat='Rp {0:N0}', ConverterCulture=id-ID}" Width="110"/>
                    <DataGridTemplateColumn Header="STATUS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Nonaktif"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Text" Value="Aktif"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" Style="{StaticResource H2}" Margin="0,0,0,16"/>

                <TextBlock Text="Gunung" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Gunungs}" SelectedItem="{Binding FGunung}" DisplayMemberPath="NamaGunung" Margin="0,0,0,14"/>

                <TextBlock Text="Nama jalur" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding FNama, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="Kuota harian (orang)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding FKuota, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="Tarif per orang (Rp)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding FTarif, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <CheckBox Content="Jalur aktif (bisa dibooking)" IsChecked="{Binding FAktif}" Margin="0,0,0,16"/>

                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                <Button Content="Simpan" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" Margin="0,0,0,8"/>
                <Button Content="Jalur Baru" Command="{Binding NewCommand}" Margin="0,0,0,8"/>
                <Button Content="Hapus" Style="{StaticResource Danger}" Command="{Binding DeleteCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>