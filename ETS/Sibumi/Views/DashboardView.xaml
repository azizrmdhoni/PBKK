<UserControl x:Class="Sibumi.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource Page}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">

            <DockPanel Margin="0,0,0,22">
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Muat ulang"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                    <TextBlock Text="Ringkasan booking dan kuota pendakian." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <Border CornerRadius="18" Padding="32,28" Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1D7F5B" Offset="0"/>
                        <GradientStop Color="#0E3F31" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Greeting}" FontSize="26" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Today}" FontSize="14" Foreground="#BFE3D3" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="300" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding KuotaPersen, StringFormat='{}{0}%'}"
                                       FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Kuota hari ini" FontSize="14" Foreground="#BFE3D3" VerticalAlignment="Bottom"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource HeroProgress}" Maximum="100" Value="{Binding KuotaPersen, Mode=OneWay}" Margin="0,10,0,8"/>
                        <TextBlock Text="{Binding KuotaText}" FontSize="12" Foreground="#BFE3D3"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,-16,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                            <StackPanel>
                                <Grid HorizontalAlignment="Left" Margin="0,0,0,16">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{Binding Accent}" Opacity="0.16"/>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="Bold" Margin="0,4,0,4" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Pendaki per Jalur" Style="{StaticResource H2}"/>
                        <TextBlock Text="Total anggota rombongan bulan ini" Style="{StaticResource Muted}" Margin="0,2,0,20"/>
                        <ItemsControl ItemsSource="{Binding Chart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ProgressBar Grid.Row="1" Style="{StaticResource BarProgress}" Maximum="{Binding Max, Mode=OneWay}"
                                                     Value="{Binding Value, Mode=OneWay}" Margin="0,8,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Belum ada jalur aktif." Style="{StaticResource Muted}"
                                   Visibility="{Binding ChartEmpty, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Aktivitas Terbaru" Style="{StaticResource H2}" Margin="0,0,0,18"/>
                        <ItemsControl ItemsSource="{Binding Activities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" Margin="0,5,14,0" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Deskripsi}" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0">
                                                <Run Text="{Binding Pengguna, Mode=OneWay}"/><Run Text=" - "/><Run Text="{Binding WaktuText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Belum ada aktivitas." Style="{StaticResource Muted}"
                                   Visibility="{Binding ActivityEmpty, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
