<Window x:Class="PendaftaranMhs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pendaftaran Mahasiswa" Height="560" Width="1000" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pendaftaran Mahasiswa"
                   FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Program studi:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbProdi" Width="240" Padding="6,4"
                      DisplayMemberPath="Nama"
                      SelectionChanged="CmbProdi_SelectionChanged"/>
            <Button x:Name="BtnRefresh" Content="Refresh" Padding="16,5" Margin="12,0,0,0"
                    Click="BtnRefresh_Click"/>
        </StackPanel>

        <DataGrid x:Name="GridMahasiswa" Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NIM"           Binding="{Binding Nim}"         Width="90"/>
                <DataGridTextColumn Header="Nama"          Binding="{Binding Nama}"        Width="160"/>
                <DataGridTextColumn Header="Program Studi" Binding="{Binding NamaProgram}" Width="150"/>
                <DataGridTextColumn Header="Tgl. Lahir"
                                    Binding="{Binding TanggalLahir, StringFormat=dd/MM/yyyy, TargetNullValue='-'}"
                                    Width="90"/>
                <DataGridTextColumn Header="Alamat"        Binding="{Binding Alamat}"      Width="*"/>
                <DataGridTextColumn Header="No. Telepon"   Binding="{Binding NoTelepon}"   Width="120"/>
                <DataGridTextColumn Header="Dibuat"
                                    Binding="{Binding DibuatPada, StringFormat=dd/MM/yyyy HH:mm}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TxtStatus" Grid.Row="3" Margin="0,10,0,0" Foreground="#4A5560"/>
    </Grid>
</Window>
